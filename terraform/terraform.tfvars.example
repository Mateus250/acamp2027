# Arquivo de exemplo para variáveis do Terraform
# Para usar, crie uma cópia chamada 'terraform.tfvars' e ajuste os valores conforme necessário.

aws_region   = "us-east-1"
project_name = "acamp2027"
environment  = "prod"

# Opcional: Especifique um nome fixo para o bucket S3 (deve ser único globalmente na AWS).
# Se deixar comentado ou vazio, o Terraform gerará acamp2027-prod-xxxxxx com sufixo aleatório.
# bucket_name = "acamp2027-prod-web"

# Classe de preço CloudFront:
# PriceClass_100: EUA/Europa/Canadá
# PriceClass_200: Inclui América do Sul/Brasil (recomendado para baixa latência)
# PriceClass_All: Todos os pontos de presença globais
price_class = "PriceClass_200"

# Domínios customizados (o primeiro é o principal do certificado ACM; os demais viram SANs).
# Use [] para servir apenas pelo domínio padrão do CloudFront.
custom_domains = [
  "acampimersos.com.br",
  "acampamentoipi.com.br",
]

# URL pública do site (usada para os callbacks da InfinitePay)
site_url = "https://acampimersos.com.br"

# ==============================================================================
# INTEGRAÇÃO INFINITEPAY & SUPABASE
# ==============================================================================
# API Key gerada no aplicativo da InfinitePay (Configurações > Checkout Integrado)
# Formato: inchk_xxxxxxxxxxxxxxxxxxxxxxxx
infinitepay_api_key = "inchk_sua_chave_aqui"

# URL do seu projeto no Supabase
supabase_url = "https://xhtnhhdpiuqdquacooau.supabase.co"

# Service Role Secret do Supabase (Project Settings > API > service_role secret)
# Necessária para que a Lambda atualize a tabela 'acampantes' ao confirmar o pagamento
supabase_service_role_key = "sua_chave_service_role_aqui"
